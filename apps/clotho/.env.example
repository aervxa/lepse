# Node
TZ=UTC
PORT=3333
HOST=localhost
NODE_ENV=development

# App
LOG_LEVEL=info
APP_KEY=
APP_URL=http://${HOST}:${PORT}
FRONTEND_URL=http://localhost:3000

# Session
SESSION_DRIVER=cookie

# Database
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=root
DB_PASSWORD=root
DB_DATABASE=app

#--------------------------------------------------------------------
# CORS (configure allowed origins for API access)
#--------------------------------------------------------------------
CORS_ORIGIN=http://localhost:3000

DRIVE_DISK=fs
# R2_* required if DRIVE_DISK is r2 | default at 'none' so server config finds the variable
R2_KEY=none
R2_SECRET=none
R2_BUCKET=none
R2_ENDPOINT=none
R2_CDN=none

# Mail
MAIL_MAILER=resend
MAIL_FROM_NAME=lepse
MAIL_FROM_ADDRESS=onboaring@resend.dev
RESEND_API_KEY=your-resend-api-key

# Rate Limiter
LIMITER_STORE=database
