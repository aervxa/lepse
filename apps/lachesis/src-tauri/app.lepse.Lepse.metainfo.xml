<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
    <id>app.lepse.Lepse</id>
    <launchable type="desktop-id">app.lepse.Lepse.desktop</launchable>
    <name>Lepse</name>
    <summary>Personal focus companion</summary>
    <description>
        <p>
            Lepse is a minimal and aesthetic productivity tool to help you focus on what matters and work toward your goals.
        </p>
        <p>
            Instead of creating tasks and then completing them in a mindless loop, link tasks to the goals they enable so that each task actually means something. Start a Pomodoro timer or a stopwatch on any task, and every second is tracked on that exact task, letting
            you see how much time you've spent on a task.
        </p>
        <p>
            Not focusing, or just needing rest? Let the clock keep you company.
        </p>
    </description>
    <keywords>
        <keyword>aesthetic</keyword>
        <keyword>productivity</keyword>
        <keyword>clock</keyword>
        <keyword>calendar</keyword>
        <keyword>pomodoro</keyword>
        <keyword>timer</keyword>
        <keyword>focus</keyword>
        <keyword>habits</keyword>
    </keywords>

    <releases>
        <release version="0.2.8" date="2026-10-02">
            <url type="details">https://github.com/aervxa/lepse/releases/tag/v0.2.8</url>
            <description>
                <p>Please look at the github release for what changed in this version.</p>
            </description>
        </release>
    </releases>

