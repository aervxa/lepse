# Node
TZ=UTC
PORT=3333
HOST=localhost
NODE_ENV=development

# App
LOG_LEVEL=info
APP_KEY=
APP_URL=http://${HOST}:${PORT}

# Session
SESSION_DRIVER=cookie

#--------------------------------------------------------------------
# CORS (configure allowed origins for API access)
#--------------------------------------------------------------------
# CORS_ORIGIN=http://localhost:5173,http://localhost:3000
DRIVE_DISK=fs
# R2_* required if DRIVE_DISK is r2 | default at 'none' so server config finds the variable
R2_KEY=none
R2_SECRET=none
R2_BUCKET=none
R2_ENDPOINT=none