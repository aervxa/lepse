{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["build/**", ".adonisjs/**"],
      "env": ["NODE_ENV", "APP_KEY", "HOST", "PORT", "LOG_LEVEL"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "@lepse/lachesis#tdev": {
      "with": ["@lepse/clotho#dev"],
      "cache": false,
      "persistent": true
    },
    "@lepse/lachesis#tdev:cef": {
      "with": ["@lepse/clotho#dev"],
      "cache": false,
      "persistent": true
    },
    "test": {
      "dependsOn": ["build"],
      "cache": false
    },
    "lint": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "format": {
      "outputs": [],
      "cache": false
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": []
    }
  }
}
