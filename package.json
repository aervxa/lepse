{
  "name": "lepse",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "A batteries-included AdonisJS starter kit for building modern APIs with type-safe frontend integration",
  "license": "MIT",
  "workspaces": [
    "apps/*"
  ],
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "turbo dev",
    "tdev": "turbo tdev",
    "tdev:cef": "turbo tdev:cef",
    "build": "turbo build",
    "test": "turbo test",
    "lint": "turbo lint",
    "format": "turbo format",
    "typecheck": "turbo typecheck"
  },
  "devDependencies": {
    "@adonisjs/prettier-config": "^1.4.5",
    "prettier": "^3.8.1",
    "turbo": "^2.8.21"
  },
  "packageManager": "npm@11.11.1",
  "allowScripts": {
    "vue-demi@0.14.10": true,
    "@parcel/watcher@2.5.6": true,
    "@swc/core@1.15.24": true,
    "better-sqlite3@12.8.0": true,
    "esbuild@0.27.7": true,
    "esbuild@0.28.0": true
  }
}
