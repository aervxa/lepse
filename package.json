{
  "name": "lepse",
  "private": true,
  "type": "module",
  "description": "A batteries-included AdonisJS starter kit for building modern APIs with type-safe frontend integration",
  "license": "SEE LICENSE IN LICENSE.md",
  "workspaces": [
    "apps/*"
  ],
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "turbo dev",
    "tdev": "turbo tdev",
    "tdev:cef": "turbo tdev:cef",
    "build": "turbo build",
    "test": "turbo test",
    "lint": "turbo lint",
    "format": "turbo format",
    "typecheck": "turbo typecheck"
  },
  "devDependencies": {
    "@adonisjs/prettier-config": "^1.4.5",
    "prettier": "^3.8.1",
    "turbo": "^2.8.21"
  },
  "packageManager": "npm@11.11.1",
  "allowScripts": {
    "vue-demi": true,
    "@parcel/watcher": true,
    "@swc/core": true,
    "better-sqlite3": true,
    "esbuild": true
  }
}
